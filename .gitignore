# Config file
.emscripten
.emscripten_backup

# Emsdk generated version info
.emsdk_version

# vim/emacs temporary/backup files
*~
*.swp

# Compiled python files
__pycache__

# Default emscripten cache
/cache

# Ignore only the root node_modules, but not any further down the path
/node_modules/

# Python coverage tool output
.coverage
.coverage.*
tools/coverage/
htmlcov/
coverage.xml

.DS_Store

# Test output
/out/

# When updating the website we check it out here.
/site/emscripten-site/

# All the ps1 files are generated by bootstrap; the launcher scripts are committed.
*.ps1
# ...except the templates.
!/tools/run_python.ps1
!/tools/run_python_compiler.ps1

/tools/pylauncher/pylauncher.obj

# dotnet changes
!/eng/**/*.ps1
/.dotnet
/.packages
/artifacts
# Generated during pack by eng/nuget/builds.targets (UpdateVersionFile)
/eng/emscripten-version.txt
